<?xml version="1.0" encoding="UTF-8"?>
<ncx version="2005-1" xml:lang="{{ language }}" xmlns="http://www.daisy.org/z3986/2005/ncx/">
<head>
<meta name="dtb:uid" content="urn:uuid:{{ uuid }}"/>
<meta name="dtb:depth" content="1"/>
<meta name="dtb:totalPageCount" content="0"/>
<meta name="dtb:maxPageNumber" content="0"/>
<meta name="generated" content="true"/>
</head>
<docTitle><text>{{ title }}</text></docTitle>
<navMap>
{% for nav in navpoints %}<navPoint id="{{ nav.id }}"><navLabel><text>{{ nav.title }}</text></navLabel><content src="{{ nav.source }}"/></navPoint>
{% endfor %}</navMap>
</ncx>
